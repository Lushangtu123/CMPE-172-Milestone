# Copy to .env.rds locally. Enter secrets only in your editor / Railway variables.
SPRING_PROFILES_ACTIVE=rds
AWS_REGION=us-east-2
RDS_HOSTNAME=replace-with-your-rds-endpoint
RDS_PORT=3306
RDS_DB_NAME=tutorconnect
RDS_USERNAME=tutorconnect
RDS_PASSWORD=
NOTIFICATION_SERVICE_TOKEN=
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_REMINDERS_ENABLED=true
# For a host-based Java process, override the Docker truststore location:
# RDS_TRUSTSTORE_URL=file:/absolute/path/to/.local/rds-ca.p12
